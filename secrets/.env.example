# Copy to secrets/.env and fill in. The whole file is optional — without it the
# app runs fine, just with the browser's built-in French voice and no
# pronunciation scoring.
#
# Azure portal -> your Speech resource -> Keys and Endpoint
#   KEY 1           -> AZURE_SPEECH_KEY
#   Location/Region -> AZURE_SPEECH_REGION (lowercase, e.g. swedencentral)

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=swedencentral

# Contact URL sent to push services with each web-push message.
PUSH_CONTACT=mailto:you@example.com

# NOTE: MAX_USERS is NOT set here — it lives in docker-compose.yml (set to 1).
# Compose's `environment:` overrides `env_file:`, so a value here would be
# silently ignored. Change the cap in docker-compose.yml.
